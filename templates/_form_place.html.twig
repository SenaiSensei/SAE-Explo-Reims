<div id ="item-{{ place.id }}" class="flex flex-row mx-auto md:mx-4 md:flex-col font-montserrat font-semibold w-full md:w-60 max-h-28 md:h-fit md:max-h-none shrink-0
    tracking-tight relative bg-almond_pastel rounded-xl shadow-[0px_4px_4px_rgba(0,0,0,0.25)] transition-transform transform hover:translate-y-[-5px] duration-300
    ease-in-out hover:shadow-[0px_6px_10px_rgba(0,0,0,0.3)] my-2">
    <img class="rounded-l-xl md:rounded-l-none md:rounded-t-xl md:shadow-md mr-1 md:mr-0 md:mb-1 object-cover aspect-auto w-1/3 md:w-full md:h-1/2"
         src="{{ path('app_imageByPlaceId', {id: place.id}) }}" alt="image"/>
    {% if Route ?? false and (Route == 'update' or Route == 'create') %}
        {{ include('itinerary/_update.html.twig') }}
    {% endif %}
    <div class="px-2 py-2 w-2/3 flex flex-col md:w-full md:h-1/2">
        {% if isGood??false %}
            {{ include('user/_favorite.html.twig',{isGood:isGood,id:place.id,route:('/place/')}) }}
        {% endif %}
        <p class="text-dark_blue text-base">{{ place.name }}</p>
        {{ include('_note.html.twig', {place: place}) }}
        <p class="text-dark_blue text-xs font-medium">Catégorie : {{ place.category.name }}</p>
        <a href="{{ path('app_placeById', {id: place.id}) }}" class="w-fit text-dark_gold text-sm ml-auto hover:text-amber-400 transition-transform duration-300 md:mt-4"
        >En savoir plus</a>
    </div>
</div>
