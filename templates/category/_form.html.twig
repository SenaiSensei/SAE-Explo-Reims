<div class="max-w-lg max-h-fit mx-auto bg-white p-6 rounded-lg shadow-md dark:bg-dark_cards dark:text-white">
    {{ form_start(form, {attr: {class: 'space-y-4'}}) }}
    <div class="flex flex-col">
        {{ form_row(form.name, {label: 'Nom de la nouvelle categorie', attr: {class: 'input-field'}}) }}
    </div>

    <button type="submit" class="w-full bg-blue-600 text-white py-2 px-4 mt-8 rounded hover:bg-blue-700 transition"
            {% if confirm_message is defined and confirm_message %}
                onclick="return confirm('{{ confirm_message }}');"
            {% endif %}
    >
        {{ submit_label }}
    </button>
    {{ form_end(form) }}
</div>
