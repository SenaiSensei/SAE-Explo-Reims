<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>{% block title %}{% endblock %}</title>
    <link rel="stylesheet" href="https://maxst.icons8.com/vue-static/landings/line-awesome/line-awesome/1.3.0/css/line-awesome.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}
</head>
<body class="flex overflow-x-hidden min-h-full bg-white_smoke dark:bg-dark_bg">
<input class="peer hidden" type="checkbox" name="" id="sidebar-toggle" checked/>

<div class="sidebar peer-checked:-translate-x-full w-70 fixed left-0 top-0 h-full py-4 px-6 bg-main_admin
                text-white z-20 translate-x-0 duration-300">

    <div class="sidebar-main mt-[70px]">
        <div class="sidebar-user my-4 mx-0 text-center">
            {% if app.user.image is not null %}
                    <img src="{{ path('app_imageById', {'id': app.user.image.id}) }}" alt="Image" class="w-full max-w-[64px] max-h-[64px] h-auto rounded-full">
                {% else %}
                    <img class="w-28 h-28 rounded-full m-auto" src="{{ asset('images/default.jpg') }}" alt="" />
            {% endif %}
            <div>
                <h3 class="text-base">{{ app.user.firstname }} {{ app.user.lastname }}</h3>
                <span class="text-sm">{{ app.user.email }}</span>
            </div>
        </div>

        <div class="sidebar-menu mt-12">
            <div class="menu-head uppercase text-menu_head text-xs font-medium mb-3">
                <span>Visualisation</span>
            </div>

            <ul class="mb-6">
                <li class="mt-3.5">
                    <a href="{{ path('app_admin_analytics') }}" class="text-white_smoke text-sm flex items-center">
                        <span class="las la-chart-pie text-2xl inline-block mr-3"></span>
                        Statistiques
                    </a>
                </li>
            </ul>

            <div class="menu-head uppercase text-menu_head text-xs font-medium mb-3">
                <span>Édition</span>
            </div>

            <ul class="mb-6">
                <li class="mt-3.5">
                    <a href="{{ path('app_admin_places') }}" class="text-white_smoke text-sm flex items-center">
                        <span class="las la-map-pin text-2xl inline-block mr-3"></span>
                        Lieux
                    </a>
                </li>
                <li class="mt-3.5">
                    <a href="{{ path('app_admin_categories') }}" class="text-white_smoke text-sm flex items-center">
                        <span class="las la-shapes text-2xl inline-block mr-3"></span>
                        Catégories
                    </a>
                </li>
                <li class="mt-3.5">
                    <a href="{{ path('app_admin_itineraries') }}" class="text-white_smoke text-sm flex items-center">
                        <span class="las la-map-marked-alt text-2xl inline-block mr-3"></span>
                        Parcours
                    </a>
                </li>
                <li class="mt-3.5">
                    <a href="{{ path('app_admin_users') }}" class="text-white_smoke text-sm flex items-center">
                        <span class="las la-user text-2xl inline-block mr-3"></span>
                        Utilisateurs
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>

<div class="main-content peer-checked:ml-0 flex-1 transition-all duration-300 ml-[280px] lg:ml-[280px] overflow-x-hidden">
    <header class="main-content-header peer-checked:left-0 peer-checked:right-0 peer-checked:w-full
                       h-18 flex justify-between items-center bg-white_smoke dark:bg-dark_bg py-4 px-6 fixed top-0 left-0 w-full
                       z-20 shadow-header_admin transition-all duration-300 lg:w-calc-sidebar">
        <div class="menu-toggle flex items-center">
            <label for="sidebar-toggle" class="text-2xl rounded-full hover:bg-white mr-6 dark:text-white dark:hover:bg-black">
                <span class="las la-bars"></span>
            </label>

            <a href="{{ path('app_admin') }}"><img src="{{ asset('images/logo.svg') }}" width="40px" alt="" class="md:hidden" /></a>
            <a href="{{ path('app_admin') }}"><h1 class="hidden md:inline-block text-3xl font-poppins dark:text-white">Backoffice Explo'Reims</h1></a>
        </div>

        <div class="header-icons">
            <button id="dark-mode-toggle" class="inline-block ml-2.5 text-2xl">
                <span id="dark-icon" class="hidden las la-moon"></span>
                <span id="light-icon" class="las la-sun dark:text-white"></span>
            </button>
            <span class="las la-user-circle inline-block ml-2.5 text-2xl dark:text-white"></span>
        </div>

    </header>
    <main class="p-6 m-h-[calc(100vh-70px)] mt-[70px] overflow-x-hidden">
        {% block body %}{% endblock %}
    </main>
</div>

<label for="sidebar-toggle" class="body-label fixed h-full w-calc-sidebar z-30 -right-full top-0 lg:peer-checked:-right-full"></label>

{% block javascripts %}
    {{ encore_entry_script_tags('app') }}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
{% endblock %}

<script src="{{ asset('js/admin-dark-mode.js') }}"></script>
</body>
</html>
