{% extends 'base.html.twig' %}

{% block title %}Log in{% endblock %}

{% block body %}
    <div class="flex flex-col min-h-screen w-full bg-cover bg-center text-almond_pastel px-9 pt-8 shadow-xl items-center justify-center"
         style="background-image: url('{{ asset('images/landing_page_bg.png') }}')">
        <div class="flex items-center justify-center">
            <form method="post" class="bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl shadow-lg px-8 pt-6 pb-8 w-full max-w-md">
                {% if error %}
                    <div class="mb-4 text-red-500 text-sm font-medium">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                {% if app.user %}
                    <div class="mb-4 text-sm text-zinc-300">
                        Vous êtes connecté en tant que <span class="font-bold">{{ app.user.userIdentifier }}</span>,
                        <a href="{{ path('app_logout') }}" class="text-blue-500 hover:underline">Déconnexion</a>
                    </div>
                {% endif %}

                <h1 class="text-2xl font-bold text-white mb-6 text-center">Connexion</h1>

                <div class="mb-6">
                        <label for="inputEmail" class="block text-white text-sm font-bold mb-2">Email</label>
                    <input type="email" value="{{ last_username }}" name="email" id="inputEmail"
                           class="shadow appearance-none border rounded-lg w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-[#f6eccf] focus:border-transparent"
                           autocomplete="email" required autofocus>
                </div>

                <div class="mb-6">
                    <label for="inputPassword" class="block text-white text-sm font-bold mb-2">Mot de passe</label>
                    <input type="password" name="password" id="inputPassword"
                           class="shadow appearance-none border rounded-lg w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-[#f6eccf] focus:border-transparent"
                           autocomplete="current-password" required>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="flex flex-col md:flex-row items-center justify-between">
                    <button type="submit"
                            class="bg-white hover:bg-[#f6eccf] text-black font-medieval font-bold mb-4 md:mb-0 md:mr-4 py-2 px-4 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                        Connexion
                    </button>
                    <a href="{{ path('app_registration') }}" class="text-sm font-bold text-white hover:text-[#f6eccf] mb-2 md:mr-2 md:mb-0">
                        S'inscrire ?
                    </a>
                    <a href="#" class="text-sm font-bold text-white hover:text-[#f6eccf]">
                        Mot de passe oublié ?
                    </a>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
