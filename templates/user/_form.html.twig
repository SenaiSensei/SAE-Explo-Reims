<div class="max-w-lg mx-auto bg-white p-6 rounded-lg shadow-md dark:bg-dark_cards dark:text-white">
    {{ form_start(form, {attr: {class: 'space-y-4'}}) }}

    <div class="flex flex-col">
        {{ form_row(form.firstname, {label: 'Prénom', attr: {class: 'input-field'}}) }}
    </div>

    <div class="flex flex-col">
        {{ form_row(form.lastname, {label: 'Nom', attr: {class: 'input-field'}}) }}
    </div>

    <div class="flex flex-col">
        {{ form_row(form.email, {label: 'Adresse e-mail', attr: {class: 'input-field'}}) }}
    </div>

    <div class="flex flex-col">
        {{ form_row(form.phone, {label: 'Numéro de téléphone', attr: {class: 'input-field'}}) }}
    </div>

    <div class="flex flex-col">
        {% if not form.password.vars.required %}
            {{ form_row(form.password, {label: 'Mot de passe', attr: {class: 'input-field', disabled: true}}) }}
        {% else %}
            {{ form_row(form.password, {label: 'Mot de passe', attr: {class: 'input-field'}}) }}
        {% endif %}
    </div>

    <div class="flex flex-wrap gap-4">
        <label class="block text-sm font-medium text-gray-700 w-full dark:text-white">Rôles</label>
        <div class="border border-gray-300 rounded-lg p-4 w-full">
            <div class="flex flex-col gap-4 sm:flex-row sm:gap-6">
                {% for role in form.roles %}
                    <div class="flex items-center gap-2">
                        {{ form_widget(role, {attr: {class: 'form-checkbox'}}) }}
                        <label for="{{ role.vars.id }}" class="text-sm font-medium text-gray-700 dark:text-white">
                            {{ role.vars.label }}
                        </label>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="flex flex-col">
        {{ form_row(form.image, {label: 'Image de profil', attr: {class: 'input-field'}}) }}
    </div>

    <div class="flex flex-col">
        {{ form_row(form.favoriteItinerary, {label: 'Itinéraires favoris', attr: {class: 'input-field'}}) }}
    </div>

    <div class="flex flex-col">
        {{ form_row(form.favoritePlace, {label: 'Lieux favoris', attr: {class: 'input-field'}}) }}
    </div>

    <button type="submit" class="w-full bg-blue-600 text-white py-2 px-4 rounded hover:bg-blue-700 transition"
            {% if confirm_message is defined and confirm_message %}
                onclick="return confirm('{{ confirm_message }}');"
            {% endif %}
    >
        {{ submit_label }}
    </button>

    {{ form_end(form) }}
</div>
