{% extends 'base.html.twig' %}

{% block title %}Modifier le mot de passe{% endblock %}

{% block body %}
    <div class="min-h-screen bg-dark_gray-100 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
        <div class="max-w-md w-full space-y-8 bg-white dark:bg-black dark:text-white p-6 rounded-lg shadow-md">
            <h1 class="text-2xl font-bold text-center text-gray-800 dark:text-gray-400">Modifier votre mot de passe</h1>

            <!-- Validation  -->
            {% for message in app.flashes('error') %}
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" role="alert">
                    {{ message }}
                </div>
            {% endfor %}

            {% for message in app.flashes('success') %}
                <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative" role="alert">
                    {{ message }}
                </div>
            {% endfor %}

            {{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}

            <!-- Current password -->
            <div>
                {{ form_label(form.current_password, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-400'}}) }}
                {{ form_widget(form.current_password, {'attr': {'class': 'block w-full mt-1 px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 dark:text-black'}}) }}
                {{ form_errors(form.current_password) }}
            </div>

            <!-- New password -->
            <div>
                {{ form_label(form.new_password, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-400'}}) }}
                {{ form_widget(form.new_password, {'attr': {'class': 'block w-full mt-1 px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 dark:text-black'}}) }}
                {{ form_errors(form.new_password) }}
            </div>

            <!-- Password comfirmation -->
            <div>
                {{ form_label(form.confirm_password, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-400'}}) }}
                {{ form_widget(form.confirm_password, {'attr': {'class': 'block w-full mt-1 px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 dark:text-black'}}) }}
                {{ form_errors(form.confirm_password) }}
            </div>

            <!-- Submit Button -->
            <div>
                <button type="submit" class="w-full bg-indigo-600 text-white py-2 px-4 rounded-lg shadow-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
                    Changer le mot de passe
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
