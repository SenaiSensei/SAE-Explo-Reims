{% if action == '-' %}
    <button class="p-1 absolute px-3 top-0 right-1 m-1 text-white rounded-md text-base bg-red-500 z-20 remove-button"
            data-id="{{ pathOrder.id }}" data-place ="{{ place.id }}" data-itinerary="{{ itinerary.id }}">-</button>
    <select id="pos-input-{{ place.id }}" class="absolute top-1 left-2 size-7 p-2 rounded-md bg-red-500 text-sm w-fit h-fit">
        {% for i in range(1, 6) %}
            <option value="{{ i }}" {% if i == pathOrder.position %}selected{% endif %}>{{ i }}</option>
        {% endfor %}
    </select>
{% endif %}
{% if action == '+' %}
    <button class="p-1 px-3 absolute top-0 right-1 m-1 text-white rounded-md text-base bg-green-500 z-20 add-button"
            type="button" data-id="{{ place.id }}" data-itinerary="{{ itinerary.id }}">+</button>
    <select id="pos-input-{{ place.id }}" class="absolute top-1 left-2 size-7 p-2 rounded-md bg-white text-sm w-fit h-fit">
        {% for i in range(1, 6) %}
            <option value="{{ i }}" {% if i == pos + 1 %}selected{% endif %}>{{ i }}</option>
        {% endfor %}
    </select>
{% endif %}
