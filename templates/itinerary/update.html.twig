{% extends 'base.html.twig' %}
{% form_theme form 'tailwind_2_layout.html.twig' %}

{% block title %}
    {% for warning in app.session.flashbag.peek('notice') %}
        {% set Route = warning %}
    {% endfor %}
    {% if Route == 'create' %}
        Création d'un itinéraire
    {% else %}
        {{ itinerary.name }} - Modification
    {% endif %}
{% endblock %}

{% block research %}
    <div class = "w-10 relative md:mr-6 text-center">
        <label class="bx bx-search-alt dark:text-white text-3xl pr-2.5 absolute left-0 top-0 md:pt-1 lg:pt-2"></label>
        <input type="checkbox" id ="menu-cb" class="w-8 h-8 absolute appearance-none left-0 top-0 hover:cursor-pointer">
        <nav id = "menu-nav" class="z-10 absolute top-10 right-5 origin-top-left">
            <ul>
                <form class="m-2 p-2 bg-white dark:bg-black rounded-sm right-0 flex flex-col " action="{{ path('app_place') }}" method ="GET">
                    <input class="rounded-sm mb-1 dark:text-white" type="search" placeholder="recherche" name="search">
                    <button class="bg-green-500 dark:bg-green-900 dark:text-white rounded-sm" type="submit">recherche</button>
                </form>
            </ul>
        </nav>
    </div>
{% endblock %}

{% block body %}
    <main class="font-montserrat max-w-6xl mx-auto px-5 pt-10">
        {% if Route == 'create' %}
            <h1 class="text-dark_blue dark:text-primary font-bold text-2xl md:text-4xl font-medieval">Création d'un itinéraire</h1>
        {% else %}
            <h1 class="text-dark_blue dark:text-primary font-bold text-2xl md:text-4xl font-medieval">Modification du parcours</h1>
        {% endif %}
        {% for warning in app.flashes('notice') %}
            {% set Route = warning %}
        {% endfor %}
        {{ form_start(form) }}
        {{ include('_flashes.html.twig') }}
        <div class="flex flex-col w-full mt-4 mb-6">
            {{ form_row(form.name, {
                label: 'Nom de l\'itinéraire',
                label_attr: {class: 'text-dark_blue dark:text-primary font-semibold md:text-lg'},
                attr: {
                    class: 'form-input p-1 text-sm md:text-base',
                    placeholder: 'Kayoux'
                }
            }) }}
            {{ form_row(form.description,{
                label: 'Description',
                label_attr: {class: 'text-dark_blue dark:text-primary font-semibold md:text-lg'},
                attr: {
                    class: 'form-input p-1 resize-none text-sm md:text-base h-32',
                    placeholder: 'Expliquez brièvement le trajet'
                }
            }) }}
            {% if Route == 'create' %}
                <input type="submit" value="Créer" class="bg-gold hover:bg-white hover:text-gold border-2 border-[#422800]-2 rounded-[30px] shadow-map-button text-white
            cursor-pointer font-semibold text-2xl px-5 leading-[50px] text-center font-truculenta w-fit mx-auto"/>
            {% else %}
                <input type="submit" value="Modifier" class="bg-gold hover:bg-white hover:text-gold border-2 border-[#422800]-2 rounded-[30px] shadow-map-button text-white
            cursor-pointer font-semibold text-2xl px-5 leading-[50px] text-center font-truculenta w-fit mx-auto"/>
            {% endif %}
        </div>
        {{ form_end(form) }}
        <input type="hidden" id="itinerary-id" value="{{ itinerary.id }}">
        <div class="justify-around rounded"></div>
        <div class ="flex flex-col mb-20 flex-wrap align-center">
            <h2 class="text-xl md:text-2xl text-dark_blue dark:text-primary font-bold">Ajouter / Supprimer un Lieu</h2>
            <div id = "places-list" class ="flex flex-col md:flex-row mt-4 flex-wrap justify-center">
                {% set pos = 0 %}
                    {% for pathOrder in itinerary.pathOrder %}
                        {% set place = pathOrder.place %}
                        {% set pos = pos + 1 %}
                        {{ include('_form_place.html.twig', {action: '-', place: place, pathOrder: pathOrder, itinerary: itinerary, Route: Route}) }}
                    {% endfor %}
                    {% for place in places %}
                        {{ include('_form_place.html.twig', {action: '+', place: place, itinerary: itinerary, Route: Route, pos: pos}) }}
                    {% endfor %}
            </div>
        </div>
        <script src="{{ asset('js/place.js') }}"></script>
        <script src="{{ asset('js/update_itinerary.js') }}"></script>
    </main>
{% endblock %}
