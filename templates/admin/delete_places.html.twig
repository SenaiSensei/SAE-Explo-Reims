{% extends 'baseAdmin.html.twig' %}

{% block title %}
    Suppression de {{ place.name }}
{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto bg-white p-6 rounded-lg shadow-md dark:bg-dark_cards dark:text-white">
        <h1 class="text-2xl font-semibold text-red-600 mb-4">Confirmer la suppression</h1>

        <p class="mb-4">Êtes-vous sûr de vouloir supprimer ce lieu ? Cette action est irréversible.</p>

        <div class="mb-6">
            <h2 class="text-lg font-semibold">Détails du lieu :</h2>
            <ul class="list-disc ml-6 mt-2">
                <li><strong>Nom :</strong> {{ place.name }}</li>
                <li><strong>Catégorie :</strong> {{ place.category.name }}</li>
                <li><strong>Description :</strong> {{ place.description }}</li>
                <li><strong>Adresse :</strong> {{ place.address }}</li>
                <li><strong>Code postal :</strong> {{ place.postalCode }}</li>
                <li><strong>Ville :</strong> {{ place.city }}</li>
                <li><strong>Latitude :</strong> {{ place.latitude }}</li>
                <li><strong>Longitude :</strong> {{ place.longitude }}</li>
                <li><strong>Prix minimum :</strong> {{ place.priceMin }}</li>
                <li><strong>Prix maximum :</strong> {{ place.priceMax }}</li>
                <li><strong>Temps de visite :</strong> {{ place.visitTime }}</li>
                <li><strong>Note moyenne :</strong> {{ place.note }}</li>
                <li><strong>Liste des accessibilités :</strong>
                    {% if place.accessibility|length > 0 %}
                        <ul class="list-disc ml-6">
                            {% for accessibility in place.accessibility %}
                                <li>{{ accessibility.name }}</li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        Aucune accessibilité disponible.
                    {% endif %}
                </li>
            </ul>
        </div>

        {{ form_start(form) }}
        <div class="flex justify-between">
            {{ form_widget(form.cancel) }}

            {{ form_widget(form.delete, {
                attr: {
                    class: 'bg-red-600 text-white py-2 px-4 rounded hover:bg-red-700 transition',
                },
            }) }}
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
