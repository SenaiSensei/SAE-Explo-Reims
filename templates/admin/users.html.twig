{% extends 'baseAdmin.html.twig' %}

{% block title %}
    Édition des utilisateurs
{% endblock %}

{% set tdClass = 'border-y-2 border-zinc-100 py-3 px-2 lg:py-4 lg:px-3 dark:text-white dark:border-[#313438]' %}
{% set thClass = 'font-poppins py-3 px-2 bg-[#EDF3F9] lg:py-4 lg:px-3 dark:bg-[#21252A] dark:text-white' %}

{% block body %}
    {% for user in users %}
        <div class="z-50 grid place-items-center min-h-full">
            <dialog class="dialog-{{ user.id }} w-full max-w-sm border border-white_smoke rounded-sm text-left p-4 dark:bg-dark_cards">
                <div class="flex flex-col">
                    <div class="flex justify-between items-center">
                        <div class="flex flex-col">
                        <h2 class="text-black font-bold dark:text-white">{{ user.firstname }} {{ user.lastname|upper }}</h2>
                        <section class="my-4">
                            <p class="dark:text-white">{{ user.phone }}</p>
                            <p class="dark:text-white">{{ user.email }}</p>
                        </section>
                        </div>

                        {% if user.image is not null %}
                            <div class="">
                                <img src="{{ path('app_imageById', {id: user.image.id}) }}" alt="Image" class="w-full max-w-[64px] max-h-[64px] h-auto rounded-full">
                            </div>
                        {% endif %}
                    </div>

                    <div class="controls box-border flex justify-between items-center pl-0 mt-4">
                        <a href="{{ path('app_admin_delete_users', {id: user.id}) }}">
                            <button class="close-btn bg-transparent p-2 hover:text-white hover:border hover:border-red-600 hover:bg-red-600 hover:rounded-lg outline-none text-red-600 text-xl cursor-pointer">Supprimer</button>
                        </a>
                        <a href="{{ path('app_admin_update_users', {id: user.id}) }}">
                            <button class="close-btn bg-transparent p-2 hover:border hover:border-orange-400 hover:bg-orange-400 hover:rounded-lg hover:text-white outline-none text-orange-400 text-xl cursor-pointer">Éditer</button>
                        </a>
                        <button class="md:hidden close-btn las la-times bg-transparent p-2 hover:text-white hover:border hover:border-[#00acee] hover:bg-[#00acee] hover:rounded-lg outline-none text-[#00acee] text-xl cursor-pointer"></button>
                        <button class="hidden md:block close-btn bg-transparent p-2 hover:text-white hover:border hover:border-[#00acee] hover:bg-[#00acee] hover:rounded-lg outline-none text-[#00acee] text-xl cursor-pointer">Fermer</button>
                    </div>
                </div>
            </dialog>
        </div>
    {% endfor %}

    <div class="flex flex-col m-auto bg-white px-2 py-3 md:px-4 md:py-5 lg:px-6 lg:py-7 border border-slate-500 rounded-lg flex-grow overflow-x-auto dark:bg-dark_cards">
        <div class="flex justify-between items-center">
            <div>
                <h1 class="text-base mb-3 md:text-2xl lg:text-4xl font-poppins dark:text-white">Liste des Utilisateurs</h1>
            </div>
            <div class="flex">
                <a href="{{ path('app_admin_create_users') }}"><button class="md:hidden bg-green-500 text-white rounded-full py-1 px-3 mb-3"><span class="las la-plus"></span></button></a>
                <a href="{{ path('app_admin_create_users') }}"><button class="hidden md:block bg-green-500 text-white rounded-full py-1 px-3 mb-3 lg:text-base lg:mr-8"><span class="las la-plus md:mr-1"></span>Ajouter</button></a>
            </div>
        </div>
        <table class="table-auto w-full whitespace-nowrap border-collapse">
            <thead class="overflow-x-auto max-w-full">
            <tr>
                <th class="{{ thClass }} text-left" id="select-all"><input type="checkbox"></th>
                <th class="{{ thClass }} text-left hidden">Id</th>
                <th class="{{ thClass }} text-left">NOM</th>
                <th class="{{ thClass }} text-left">Prénom</th>
                <th class="{{ thClass }} text-left hidden md:table-cell">Roles</th>
                <th class="{{ thClass }} hidden md:table-cell text-center">Téléphone</th>
                <th class="{{ thClass }} text-left" colspan="3">Actions</th>
            </tr>
            </thead>
            <tbody class="">
            {% for user in users %}
                <tr>
                    <td class="{{ tdClass }} text-left"><input type="checkbox"></td>
                    <td class="{{ tdClass }} text-left hidden">{{ user.id }}</td>
                    <td class="{{ tdClass }}">{{ user.lastname|upper }}</td>
                    <td class="{{ tdClass }}">{{ user.firstname }}</td>
                    <td class="{{ tdClass }} hidden md:table-cell">
                        {% if 'ROLE_ADMIN' in user.roles %}
                            <span class="las la-user-cog text-2xl mr-4" title="Admin"></span>
                        {% endif %}
                        {% if 'ROLE_USER' in user.roles %}
                            <span class="las la-user text-2xl" title="Utilisateur"></span>
                        {% else %}
                            <span class="las la-question-circle" title="Sans rôle"></span>
                        {% endif %}
                    </td>
                    <td class="{{ tdClass }} hidden md:table-cell text-center">{{ user.phone }}</td>
                    <td class="{{ tdClass }} text-center md:text-left">
                        <button id="open-popup" data-id="{{ user.id }}" class="las la-eye text-blue-500 text-2xl"></button>
                    </td>
                    <td class="{{ tdClass }} text-center hidden md:table-cell md:text-left">
                        <a href="{{ path('app_admin_update_users', {id: user.id}) }}"><span class="las la-edit text-green-600 text-2xl"></span></a>
                    </td>
                    <td class="{{ tdClass }} text-center hidden md:table-cell md:text-left">
                        <a href="{{ path('app_admin_delete_users', {id: user.id}) }}"><span class="las la-trash text-red-600 text-2xl"></span></a>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <script src="{{ asset('js/popup-backoffice.js') }}"></script>
    <script src="{{ asset('js/selected-data.js') }}" ></script>
{% endblock %}
