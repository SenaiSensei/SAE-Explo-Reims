{% extends 'baseAdmin.html.twig' %}

{% block title %}
    Backoffice
{% endblock %}

{% block body %}
    <div class="flex flex-col px-4 py-6 space-y-6">
        <div class="flex justify-center mb-6">
            <div class="text-center">
                <h1 class="text-3xl font-bold font-poppins animate-fadeIn dark:text-white">Bienvenue, {{ app.user.firstname }}</h1>
                <p class="text-lg mt-2 text-gray-600 animate-fadeIn delay-100 dark:text-white">
                    {{ "now"|format_datetime('full', 'none', locale='fr') }}
                </p>
                <p class="text-lg mt-2 text-gray-600 animate-fadeIn delay-100 lg:block hidden dark:text-white">{{ "now"|date("H:i") }}</p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

            {{ include('admin/analytics/_card_stats.html.twig') }}

            {{ include('admin/analytics/_last_logged_in.html.twig') }}

            {{ include('admin/analytics/_card_itinerary.html.twig') }}
        </div>
    </div>
{% endblock %}