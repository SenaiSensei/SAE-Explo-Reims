{% set thClass = "px-4 py-2 lg:py-6 text-left text-sm font-semibold text-gray-700 dark:text-white" %}
{% set tdClass = "px-4 py-2 lg:py-4 text-sm text-gray-800 dark:text-white" %}

<div class="bg-white shadow-lg rounded-lg lg:row-span-2 p-6 min-h-32 animate-fadeIn delay-300 dark:bg-dark_cards">
    <h3 class="text-lg font-semibold text-gray-700 mb-4 dark:text-white">Derniers Utilisateurs Connectés</h3>
    <div class="overflow-x-auto">
        <table class="min-w-full table-auto">
            <thead>
            <tr class="bg-gray-100 dark:bg-[#232325]">
                <th class="{{ thClass }}">Nom</th>
                <th class="{{ thClass }}">Prénom</th>
                <th class="{{ thClass }}">Email</th>
                <th class="{{ thClass }}">Dernière Connexion</th>
            </tr>
            </thead>
            <tbody>
            {% for user in lastUsers %}
                <tr class="border-b hover:bg-gray-50 dark:hover:bg-[#1F1F20]">
                    <td class="{{ tdClass }}">{{ user.lastname }}</td>
                    <td class="{{ tdClass }}">{{ user.firstname }}</td>
                    <td class="{{ tdClass }}">{{ user.email }}</td>
                    <td class="{{ tdClass }}">{{ user.lastLogin|date('d/m/Y H:i') }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>